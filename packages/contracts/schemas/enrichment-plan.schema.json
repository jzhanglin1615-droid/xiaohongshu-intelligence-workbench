{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xhs-workbench/contracts/enrichment-plan.schema.json",
  "title": "EnrichmentPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "scopeId", "tasks", "blockedTargets", "skippedDueToBudget", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "planId": { "type": "string", "minLength": 1 },
    "scopeId": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "noteId", "priority", "stages", "reasons", "rankingSignal", "currentRank"],
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "noteId": { "type": "string", "minLength": 1 },
          "priority": { "type": "number", "minimum": 0, "maximum": 100 },
          "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["DETAIL", "COMMENTS"] } },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rankingSignal": { "enum": ["NEW_ENTRY", "REENTERED", "RISING", "FALLING", "UNCHANGED", "DROPPED", "NOT_OBSERVED"] },
          "currentRank": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "blockedTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["noteId", "reasons", "rankingSignal"],
        "properties": {
          "noteId": { "type": "string", "minLength": 1 },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rankingSignal": { "enum": ["NEW_ENTRY", "REENTERED", "RISING", "FALLING", "UNCHANGED", "DROPPED", "NOT_OBSERVED"] }
        }
      }
    },
    "skippedDueToBudget": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
